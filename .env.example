# ARTHA — Environment Variables
# ===============================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- NVIDIA NIM (LLM Provider) ---
# Get your API key at https://build.nvidia.com/settings/api-keys
# Key starts with "nvapi-"
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_MODEL=moonshotai/kimi-k2.6
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# --- Context Budget ---
MAX_CONTEXT_TOKENS=200000
MAX_OUTPUT_TOKENS=4096
LLM_TEMPERATURE=0.2

# --- BM25 Retrieval ---
BM25_TOP_K=15
BM25_INDEX_DIR=indexes
CORPUS_DIR=corpus

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://artha:artha_secret@localhost:5432/artha
DATABASE_URL_SYNC=postgresql+psycopg2://artha:artha_secret@localhost:5432/artha
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=20

# --- Auth (JWT) ---
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET_KEY=artha-dev-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Application ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
LOG_LEVEL=INFO
APP_TITLE=ARTHA
APP_VERSION=1.0.0
